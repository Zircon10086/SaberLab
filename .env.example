# SaberLab 本地配置文件（密钥）。把真实密钥填在等号后面即可。
# 说明：SaberLab 只从这个文件读取 AI 密钥——系统环境变量不生效。
#       本文件包含密钥，已在 .gitignore 中排除，请勿分享给他人。

# DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 通义千问 DashScope API Key（https://dashscope.console.aliyun.com）
DASHSCOPE_API_KEY=

# OpenAI API Key（可选）
OPENAI_API_KEY=
